# Already set for the site chatbot
LOVABLE_API_KEY=

# Server only. Used for the per-visitor rate limit. Never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Used to hash visitor IPs.
